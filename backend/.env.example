# Production defaults. Store the actual file OUTSIDE the repository, mode 0600.
PUBLIC_ORIGIN=https://training.example.com
COOKIE_SECURE=true
ALLOW_DEMO_AUTH=false
SEED_DEMO_DATA=false
DATABASE_URL=sqlite:////var/lib/thin-muscle/thin_muscle.db
CORS_ORIGINS=[]
# Optional Twilio Verify adapter; confirm provider coverage for your target countries.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# WeChat official-account webpage authorization
WX_APP_ID=
WX_APP_SECRET=
# WeChat Open Platform website QR authorization
WX_WEB_APP_ID=
WX_WEB_APP_SECRET=
# AI food recognition only. Set a vision-capable model available in your account.
AI_FOOD_ENABLED=false
AI_GATEWAY_BASE_URL=https://api.apikey.fan/v1
AI_GATEWAY_API_KEY=
AI_VISION_MODEL=
# Stripe Checkout: confirm merchant eligibility before enabling payment methods.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHODS=["card"]
# If supported by your merchant account: ["card","alipay","wechat_pay"]
